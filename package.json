{
  "name": "repo-bridge-mcp",
  "version": "1.0.0",
  "description": "MCP coding bridge that lets ChatGPT Web (or any MCP client) read, edit, build, test, and ship real repositories — local or remote Git — without needing an LLM API key.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "repo-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "stdio": "node --env-file-if-exists=.env dist/index.js --stdio",
    "http": "node --env-file-if-exists=.env dist/index.js --http",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "node --test dist/test/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:http": "node scripts/http-check.mjs",
    "verify": "npm run build && npm test && npm run test:e2e && npm run test:http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
