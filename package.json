{
  "name": "repo-bridge-mcp",
  "version": "1.0.1",
  "description": "MCP server that turns ChatGPT Web into a real coding agent on your own repositories: read, search, edit, build, test, git, pull requests. OAuth 2.1. No OpenAI API key.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "repo-bridge": "dist/index.js"
  },
  "// files": "Explicit, so packaging never depends on .gitignore fallback behaviour. dist/ is gitignored but must ship.",
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.map",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    ".env.example"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "chatgpt",
    "chatgpt-connector",
    "coding-agent",
    "ai-agent",
    "ai-coding-assistant",
    "agentic",
    "oauth2",
    "developer-tools",
    "git",
    "automation",
    "self-hosted"
  ],
  "author": "zcrossoverz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcrossoverz/repo-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/zcrossoverz/repo-bridge/issues"
  },
  "homepage": "https://github.com/zcrossoverz/repo-bridge#readme",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "stdio": "node --env-file-if-exists=.env dist/index.js --stdio",
    "http": "node --env-file-if-exists=.env dist/index.js --http",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "node --test dist/test/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:http": "node scripts/http-check.mjs",
    "verify": "npm run build && npm test && npm run test:e2e && npm run test:http",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
