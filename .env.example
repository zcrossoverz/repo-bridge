# ── repo-bridge configuration ────────────────────────────────────────────────
# Copy to .env and edit. Every value has a safe default except the workspace
# roots and (in HTTP mode) the token.

# ── transport ────────────────────────────────────────────────────────────────
# stdio = local MCP clients (Claude Code, Cursor, MCP Inspector)
# http  = remote endpoint for ChatGPT Web
# both  = run both at once
REPO_BRIDGE_MODE=http
REPO_BRIDGE_HOST=127.0.0.1
REPO_BRIDGE_PORT=8848

# ── authentication (http mode only; stdio needs none) ────────────────────────
# oauth       OAuth 2.1 with dynamic client registration and PKCE.
#             THE ONLY MODE CHATGPT WEB SUPPORTS — its UI has no field for a
#             custom Authorization header. You authorise once in a browser.
# path-token  Shared secret in the URL path (/mcp/<token>) or a bearer header.
#             DEVELOPMENT ONLY — for temporary tunnels, curl and MCP Inspector.
# none        No authentication. Loopback only unless you override it below.
REPO_BRIDGE_AUTH=oauth

# Required for oauth and path-token.
#   oauth      → the passphrase you type on the consent screen
#   path-token → the secret carried in the URL
# Minimum 24 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPO_BRIDGE_TOKEN=

# The public HTTPS origin clients reach you at, e.g. your tunnel hostname.
# OAuth metadata must advertise the exact URL the client used. Leave empty to
# derive it from Host / X-Forwarded-* headers; set it explicitly if your proxy
# rewrites them or if discovery fails.
# REPO_BRIDGE_PUBLIC_URL=https://bridge.example.com

# Token lifetimes for oauth mode (seconds). Refresh tokens rotate on use.
# REPO_BRIDGE_OAUTH_ACCESS_TTL=3600
# REPO_BRIDGE_OAUTH_REFRESH_TTL=2592000

# Required to run REPO_BRIDGE_AUTH=none on a non-loopback interface. Do not set
# this with a public tunnel: it exposes file writing and command execution to
# anyone who finds the URL.
# REPO_BRIDGE_ALLOW_INSECURE=false

# Optional extra lock: only these client IPs may connect (exact match).
# REPO_BRIDGE_IP_ALLOWLIST=203.0.113.10

# ── permissions ──────────────────────────────────────────────────────────────
# read_only  search, read files, inspect git
# edit       + create/modify/move/delete files
# develop    + build, test, lint, approved commands, local git (branch, commit)
# full       + push and pull-request creation
REPO_BRIDGE_PERMISSION=develop

# ── workspaces ───────────────────────────────────────────────────────────────
# Directories the bridge may open, as alias=path, separated by ';'.
# Nothing outside these roots can be read or written. Required for local mode.
REPO_BRIDGE_WORKSPACES=quantix=D:\projects\quantix;demo=D:\projects\demo

# Where repo_open_remote clones repositories. Default: <data dir>/workspaces
# REPO_BRIDGE_MANAGED_ROOT=

# Bridge state (workspace registry, session change logs, audit.log).
# Default: ~/.repo-bridge
# REPO_BRIDGE_DATA_DIR=

# ── command execution ────────────────────────────────────────────────────────
# REPO_BRIDGE_EXEC_TIMEOUT_MS=600000
# REPO_BRIDGE_MAX_OUTPUT_BYTES=120000

# Extra executables to allow, on top of the built-in development toolchain list.
# REPO_BRIDGE_ALLOW_COMMANDS=terraform,helm

# Executables to ban outright; overrides everything else.
# REPO_BRIDGE_DENY_COMMANDS=docker

# Leave false. Enabling it lets run_command use a real shell, which means
# pipes, && and redirects — and removes the guarantee that content coming out
# of a repository cannot chain a second command.
# REPO_BRIDGE_ALLOW_SHELL=false

# ── git ──────────────────────────────────────────────────────────────────────
# REPO_BRIDGE_PROTECTED_BRANCHES=main,master,develop,release/*,production
# REPO_BRIDGE_GIT_AUTHOR_NAME=repo-bridge
# REPO_BRIDGE_GIT_AUTHOR_EMAIL=repo-bridge@localhost
# Appended to every bridge commit message, e.g. a co-author trailer.
# REPO_BRIDGE_COMMIT_TRAILER=

# ── forge (remote Git mode) ──────────────────────────────────────────────────
# GitHub: needs "repo" scope, or fine-grained Contents+Pull requests: write.
# GITHUB_TOKEN=
# GitLab: needs "api" scope.
# GITLAB_TOKEN=
# Self-hosted instances:
# REPO_BRIDGE_GITHUB_API=https://github.example.com/api/v3
# REPO_BRIDGE_GITLAB_API=https://gitlab.example.com/api/v4

# ── logging ──────────────────────────────────────────────────────────────────
# REPO_BRIDGE_LOG_LEVEL=info
# REPO_BRIDGE_LOG_FILE=./logs/repo-bridge.log

# Extra path fragments that must never be readable, beyond the built-in
# credential-file list (comma separated, matched case-insensitively).
# REPO_BRIDGE_SECRET_PATTERNS=internal-notes,customer-data
